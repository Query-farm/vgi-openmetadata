# ---------------------------------------------------------------- lineage

query TTTTT
SELECT level, upstream_qualified_name, upstream_column, downstream_column, transformation
FROM openmetadata.main.lineage_edges
WHERE downstream_fqn = 'snowflake_prod.analytics.marts.fct_orders'
ORDER BY level DESC, upstream_qualified_name, downstream_column;
----
dataset	analytics.raw.customers	NULL	NULL	NULL
dataset	analytics.staging.stg_orders	NULL	NULL	NULL
column	analytics.raw.customers	email	customer_email	NULL
column	analytics.staging.stg_orders	order_id	order_id	NULL
column	analytics.staging.stg_orders	amount	order_total	sum(amount)

query TTTT
SELECT upstream_fqn, pipeline_fqn, lineage_source, created_at FROM openmetadata.main.lineage_edges
WHERE downstream_fqn = 'snowflake_prod.analytics.marts.fct_orders' AND level = 'dataset' ORDER BY 1;
----
snowflake_prod.analytics.raw.customers	NULL	QueryLineage	2026-11-05 00:00:00+00
snowflake_prod.analytics.staging.stg_orders	airflow_prod.daily_orders	QueryLineage	2026-11-05 00:00:00+00

# upstream_fqn alone flips the call to downstream edges, so non-table targets appear.
query TT
SELECT downstream_type, downstream_fqn FROM openmetadata.main.lineage_edges
WHERE upstream_fqn = 'snowflake_prod.analytics.marts.fct_orders' AND level = 'dataset';
----
dashboard	looker_prod.sales_overview

# Unfiltered: every table's upstream edges.
query II
SELECT count(*) FILTER (WHERE level = 'dataset'), count(*) FILTER (WHERE level = 'column') FROM openmetadata.main.lineage_edges;
----
4	6

query TTIT
SELECT DISTINCT direction, upstream_qualified_name, degree, downstream_qualified_name
FROM openmetadata.main.lineage('snowflake_prod.analytics.marts.fct_orders', downstream_depth := 0)
WHERE level = 'dataset' ORDER BY degree, upstream_qualified_name;
----
upstream	analytics.raw.customers	1	analytics.marts.fct_orders
upstream	analytics.staging.stg_orders	1	analytics.marts.fct_orders
upstream	analytics.raw.orders	2	analytics.staging.stg_orders

query TTI
SELECT DISTINCT downstream_type, downstream_fqn, degree
FROM openmetadata.main.lineage('snowflake_prod.analytics.raw.customers', upstream_depth := 0, downstream_depth := 5)
WHERE level = 'dataset' ORDER BY degree, downstream_fqn;
----
table	snowflake_prod.analytics.marts.dim_customers	1
table	snowflake_prod.analytics.marts.fct_orders	1
dashboard	looker_prod.sales_overview	2
mlmodel	mlflow_prod.churn_model	2

query I
SELECT count(*) FROM openmetadata.main.lineage('looker_prod.sales_overview', entity_type := 'dashboard', downstream_depth := 0, upstream_depth := 1);
