# ---------------------------------------------------------------- sample_data()

# PII-tagged columns (customer_email) are never returned.
query ITT
SELECT row_number, column_name, value FROM openmetadata.main.sample_data('snowflake_prod.analytics.marts.fct_orders')
WHERE row_number <= 2 ORDER BY row_number, column_name;
----
1	customer_id	10
1	order_date	2026-11-01
1	order_id	1
1	order_total	99.5
2	customer_id	11
2	order_date	2026-11-01
2	order_id	2
2	order_total	12.0

query I
SELECT count(*) FROM openmetadata.main.sample_data('snowflake_prod.analytics.marts.fct_orders') WHERE column_name = 'customer_email';
----
0

query IT
SELECT count(*), count(value) FROM openmetadata.main.sample_data('snowflake_prod.analytics.marts.fct_orders', max_rows := 3) WHERE column_name = 'order_total';
----
3	2

# A table tagged PII itself returns nothing.
query I
SELECT count(*) FROM openmetadata.main.sample_data('postgres_app.app.public.users');
----
0

# ---------------------------------------------------------------- authentication

statement ok
CREATE OR REPLACE SECRET om (TYPE openmetadata, HOST_PORT '{OPENMETADATA_MOCK_AUTH}', TOKEN 'wrong-token');

statement error
SELECT count(*) FROM openmetadata.main.tags;
----
<REGEX>:.*HTTP 401 \(check the openmetadata secret's TOKEN\).*

statement ok
CREATE OR REPLACE SECRET om (TYPE openmetadata, HOST_PORT '{OPENMETADATA_MOCK_AUTH}', TOKEN 'test-token');

query I
SELECT count(*) FROM openmetadata.main.tags;
----
6

statement ok
DETACH openmetadata;
