query TT
SELECT run_at, status FROM openmetadata.main.assertion_results
WHERE table_fqn = 'snowflake_prod.analytics.marts.fct_orders'
  AND assertion_fqn = 'snowflake_prod.analytics.marts.fct_orders.row_count_between'
  AND run_at >= TIMESTAMPTZ '2026-11-02 00:00:00+00' AND run_at < TIMESTAMPTZ '2026-11-03 00:00:00+00';
----
2026-11-02 06:30:00+00	Failed

query I
SELECT count(*) > 0 FROM read_json('{OPENMETADATA_MOCK_STRICT}/__requests')
WHERE path = '/v1/dataQuality/testCases/testCaseResults/snowflake_prod.analytics.marts.fct_orders.row_count_between'
  AND json_extract_string(to_json(params), '$.startTs') = '1793577600000'
  AND json_extract_string(to_json(params), '$.endTs') = '1793664000000';
