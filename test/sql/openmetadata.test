# Tables nobody owns.
query T
SELECT qualified_name FROM openmetadata.main.datasets WHERE len(owners) = 0;
----
app.public.users

# id and fqn fetch entities directly; unknown ones are simply absent.
query T
SELECT qualified_name FROM openmetadata.main.datasets
WHERE id IN ('a65ee291-a716-57e2-a7aa-ee4406982336', '00000000-0000-0000-0000-000000000000');
----
analytics.marts.fct_orders

query T
SELECT name FROM openmetadata.main.datasets
WHERE fqn IN ('snowflake_prod.analytics.raw.orders', 'snowflake_prod.analytics.raw.nope') ORDER BY name;
----
orders

# ---------------------------------------------------------------- pushdown, proven by the strict mock

statement ok
CREATE OR REPLACE SECRET om (TYPE openmetadata, HOST_PORT '{OPENMETADATA_MOCK_STRICT}/api', PAGE_SIZE '2');

# The strict mock refuses an unfiltered table listing ...
statement error
SELECT count(*) FROM openmetadata.main.datasets;
----
<REGEX>:.*strict mode: unfiltered /v1/tables listing refused.*

# ... so these only pass because the filters became a search query_filter.
query T
SELECT qualified_name FROM openmetadata.main.datasets
WHERE service = 'snowflake_prod' AND tier = 'Tier.Tier1' ORDER BY qualified_name;
----
analytics.marts.dim_customers
analytics.marts.fct_orders

query T
SELECT qualified_name FROM openmetadata.main.datasets WHERE list_contains(owners, 'alice') ORDER BY qualified_name;
----
analytics.marts.fct_orders
analytics.raw.customers

query T
SELECT qualified_name FROM openmetadata.main.datasets WHERE list_contains(tags, 'PII.Sensitive');
----
app.public.users

query T
SELECT qualified_name FROM openmetadata.main.datasets WHERE domain = 'Sales' AND schema IN ('marts', 'raw') ORDER BY 1;
----
analytics.marts.dim_customers
analytics.marts.fct_orders

query T
SELECT qualified_name FROM openmetadata.main.datasets WHERE database = 'app' AND subtype = 'Regular';
----
app.public.users

# The exact query_filter the worker sent.
query I
SELECT count(*) > 0 FROM read_json('{OPENMETADATA_MOCK_STRICT}/__requests')
WHERE path = '/v1/search/query'
  AND json_extract_string(to_json(params), '$.query_filter')
      = '{"query":{"bool":{"must":[{"bool":{"should":[{"term":{"service.name.keyword":"snowflake_prod"}}]}},{"bool":{"should":[{"term":{"tier.tagFQN":"Tier.Tier1"}}]}}]}}}'
  AND json_extract_string(to_json(params), '$.index') = 'table_search_index';
----
true

query I
SELECT count(*) > 0 FROM read_json('{OPENMETADATA_MOCK_STRICT}/__requests')
WHERE json_extract_string(to_json(params), '$.query_filter')
      = '{"query":{"bool":{"must":[{"bool":{"should":[{"term":{"owners.name.keyword":"alice"}}]}}]}}}';
----
true

# search_after paging was used (PAGE_SIZE 2, two Tier 1 tables).
query I
SELECT count(*) > 0 FROM read_json('{OPENMETADATA_MOCK_STRICT}/__requests')
WHERE json_extract_string(to_json(params), '$.search_after') = 'snowflake_prod.analytics.marts.fct_orders';
----
true

