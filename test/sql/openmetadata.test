query I
SELECT count(*) > 0 FROM read_json('{OPENMETADATA_MOCK_STRICT}/__requests')
WHERE path = '/v1/dataQuality/testCases/testCaseIncidentStatus'
  AND json_extract_string(to_json(params), '$.testCaseResolutionStatusType') = 'Assigned'
  AND json_extract_string(to_json(params), '$.startTs') = '1793491200000';
----
true

