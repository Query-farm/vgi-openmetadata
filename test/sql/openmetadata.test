order_total	[Business.Revenue]

# Nested STRUCT children become dotted paths.
query TI
SELECT column_name, ordinal_position FROM openmetadata.main.columns
WHERE dataset_id = 'dbb443e2-d7bb-5613-bc02-f20a4bd6b0c8' AND column_name LIKE 'address%' ORDER BY ordinal_position;
----
address	4
address.city	5
address.zip	6

query TT
SELECT qualified_name, column_name FROM openmetadata.main.columns
WHERE list_contains(tags, 'PII.Sensitive') ORDER BY qualified_name, column_name;
