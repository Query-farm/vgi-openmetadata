analytics.marts.fct_orders	snowflake	snowflake_prod	analytics	marts	fct_orders	Regular	Tier.Tier1	Sales	5
analytics.raw.customers	snowflake	snowflake_prod	analytics	raw	customers	Regular	Tier.Tier3	NULL	4
analytics.raw.orders	snowflake	snowflake_prod	analytics	raw	orders	Regular	Tier.Tier3	NULL	4
analytics.staging.stg_orders	snowflake	snowflake_prod	analytics	staging	stg_orders	View	NULL	NULL	3
app.public.users	postgres	postgres_app	app	public	users	Regular	Tier.Tier2	NULL	3

