# Pushdown of table, test case and time ranges, proven by the strict mock (it refuses
# test-case listings without entityLink and time-series calls with startTs=0).
statement ok
CREATE OR REPLACE SECRET om (TYPE openmetadata, HOST_PORT '{OPENMETADATA_MOCK_STRICT}', PAGE_SIZE '2');

statement error
SELECT count(*) FROM openmetadata.main.assertions;
----
<REGEX>:.*strict mode: test case listing without entityLink refused.*

