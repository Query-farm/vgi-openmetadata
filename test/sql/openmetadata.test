# name: test/sql/openmetadata.test
# description: SQL tests for the openmetadata worker against the strict OpenMetadata 1.6 REST replay server
# group: [openmetadata]

require vgi

require-env OPENMETADATA_WORKER

require-env OPENMETADATA_MOCK

require-env OPENMETADATA_MOCK_AUTH

require-env OPENMETADATA_MOCK_STRICT

# json + httpfs read the replay server's request log, to assert exactly what was sent.
statement ok
LOAD json;

statement ok
LOAD httpfs;

statement ok
ATTACH 'openmetadata' (TYPE vgi, LOCATION '{OPENMETADATA_WORKER}');

# ---------------------------------------------------------------- configuration errors

statement error
SELECT count(*) FROM openmetadata.main.datasets;
----
<REGEX>:.*no openmetadata secret found.*

statement ok
CREATE OR REPLACE SECRET om (TYPE openmetadata, HOST_PORT 'localhost:8585');

statement error
SELECT count(*) FROM openmetadata.main.datasets;
----
<REGEX>:.*host_port must start with http.*

statement ok
CREATE OR REPLACE SECRET om (TYPE openmetadata, HOST_PORT '{OPENMETADATA_MOCK}', PAGE_SIZE '5000');

statement error
SELECT count(*) FROM openmetadata.main.datasets;
----
<REGEX>:.*page_size must be between 1 and 1000.*

# PAGE_SIZE 2 makes every scan page through several requests; this mock also answers every
# third new request with 429 + Retry-After, so the retry path runs throughout.
statement ok
CREATE OR REPLACE SECRET om (TYPE openmetadata, HOST_PORT '{OPENMETADATA_MOCK}', UI_URL 'https://om.example.com', PAGE_SIZE '2');

